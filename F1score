        <div class="flex items-center justify-between gap-2">
          <select id="maxSwapsSelect" class="bg-slate-950 border border-slate-700 text-xs text-slate-200 rounded px-2 py-1">
            <option value="unlimited">全局最高分</option>
            <option value="1">最多換 1 項</option>
            <option value="2">最多換 2 項</option>
            <option value="3" selected>最多換 3 項</option>
          </select>
          <button onclick="runOptimizer()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition">
            計算最佳陣容
