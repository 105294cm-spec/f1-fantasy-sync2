      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold text-white">目前陣容</h2>
        <div class="flex gap-1.5">
          <button onclick="loadPresetRoster()" class="text-[11px] bg-slate-800 hover:bg-slate-700 text-amber-300 px-2 py-1 rounded">預設陣容</button>
          <button onclick="clearRoster()" class="text-[11px] bg-slate-800 hover:bg-rose-700 text-slate-300 px-2 py-1 rounded">清空</button>
        </div>
      </div>

      <!-- 陣容數據摘要 -->
      <div class="grid grid-cols-4 gap-2 text-center bg-slate-950/80 border border-slate-800 rounded-lg p-2.5">
        <div>
          <div class="text-[10px] text-slate-400">編制</div>
          <div id="statCount" class="text-xs font-bold text-white mt-0.5">0/2 · 0/5</div>
        </div>
        <div>
          <div class="text-[10px] text-slate-400">花費</div>
          <div id="statCost" class="text-xs font-bold text-sky-400 mt-0.5">$0.0M</div>
        </div>
        <div>
          <div class="text-[10px] text-slate-400">剩餘</div>
          <div id="statRemaining" class="text-xs font-bold text-emerald-400 mt-0.5">$133.7M</div>
        </div>
        <div>
          <div class="text-[10px] text-slate-400">積分 (PPM)</div>
