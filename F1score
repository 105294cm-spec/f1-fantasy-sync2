        <h2 class="text-sm font-bold text-white">選手與車隊列表（價格高 → 低）</h2>
        <input id="searchInput" type="text" oninput="renderPool()" placeholder="搜尋名稱..."
          class="w-44 sm:w-56 bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1 text-xs text-white focus:outline-none focus:border-indigo-500" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 flex-1">
        <!-- 車隊清單 -->
