            <span id="constructorCountBadge" class="text-slate-400 font-normal">0</span>
          </div>
          <div id="constructorPoolList" class="overflow-y-auto space-y-1.5 pr-1 flex-1"></div>
        </div>

        <!-- 車手清單 -->
        <div class="bg-slate-950/70 border border-slate-800 rounded-lg p-2.5 flex flex-col max-h-[76vh]">
          <div class="text-xs font-bold text-sky-300 pb-1.5 mb-2 border-b border-slate-800 flex justify-between">
            <span>車手</span>
            <span id="driverCountBadge" class="text-slate-400 font-normal">0</span>
          </div>
          <div id="driverPoolList" class="overflow-y-auto space-y-1.5 pr-1 flex-1"></div>
        </div>
      </div>
    </section>

  </main>

  <!-- 資料同步與匯入 Modal -->
  <div id="dataModal" class="fixed inset-0 z-50 hidden bg-black/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 rounded-xl max-w-3xl w-full max-h-[88vh] flex flex-col">
      <div class="flex items-center justify-between px-4 py-3 border-b border-slate-800">
        <h3 class="text-sm font-bold text-white">更新數據 / JSON 同步</h3>
        <button onclick="closeDataModal()" class="text-slate-400 hover:text-white text-lg px-2">✕</button>
      </div>

      <div class="flex border-b border-slate-800 px-4 bg-slate-950/50 text-xs">
        <button id="mTabJson" onclick="switchModalTab('json')" class="py-2 px-3 font-bold border-b-2 border-indigo-500 text-indigo-400">JSON 同步</button>
        <button id="mTabPaste" onclick="switchModalTab('paste')" class="py-2 px-3 font-bold border-b-2 border-transparent text-slate-400 hover:text-white">貼上匯入</button>
        <button id="mTabTable" onclick="switchModalTab('table')" class="py-2 px-3 font-bold border-b-2 border-transparent text-slate-400 hover:text-white">手動微調</button>
      </div>

      <div class="p-4 overflow-y-auto flex-1 space-y-4 text-xs">
        <div id="modalPanelJson" class="space-y-3">
          <div class="flex flex-col sm:flex-row gap-2">
            <input id="jsonUrlInput" type="url" placeholder="https://raw.githubusercontent.com/.../f1_fantasy_data.json"
              class="flex-1 bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-emerald-500" />
            <button onclick="fetchRemoteJson(true)" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-2 rounded-lg whitespace-nowrap">
              立即同步 JSON
            </button>
          </div>
          <label class="flex items-center gap-2 text-slate-300 cursor-pointer">
            <input id="autoSyncCheckbox" type="checkbox" onchange="saveSyncSettings()" class="rounded bg-slate-900 border-slate-600" />
            <span>開啟網頁時自動同步 JSON</span>
          </label>
          <div class="pt-2 border-t border-slate-800 space-y-2">
            <div class="text-slate-400">或匯入本機 .json 檔：</div>
            <input type="file" accept=".json,application/json" onchange="handleLocalJsonFile(event)" class="text-slate-300" />
          </div>
          <div id="jsonStatusMsg" class="text-slate-300"></div>
        </div>

        <div id="modalPanelPaste" class="hidden space-y-3">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div>
              <label class="block text-slate-300 mb-1">車隊資料</label>
              <textarea id="pasteConstructorBox" rows="5" class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2 font-mono"></textarea>
            </div>
            <div>
              <label class="block text-slate-300 mb-1">車手資料</label>
              <textarea id="pasteDriverBox" rows="5" class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2 font-mono"></textarea>
            </div>
          </div>
          <div class="flex gap-2">
            <button onclick="previewParsedPaste()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-3 py-1.5 rounded-lg">預覽解析</button>
            <button id="applyPasteBtn" onclick="applyParsedPaste()" disabled class="bg-emerald-600 disabled:opacity-40 hover:bg-emerald-500 text-white font-bold px-3 py-1.5 rounded-lg">套用更新</button>
          </div>
          <div id="pastePreviewArea" class="hidden bg-slate-950 border border-slate-800 rounded-lg p-2.5 max-h-44 overflow-y-auto"></div>
        </div>

        <div id="modalPanelTable" class="hidden space-y-3">
          <div class="flex justify-between items-center">
            <span class="text-slate-400">修改價格與積分後儲存</span>
            <button onclick="resetToDefaultData()" class="text-rose-400 hover:underline">恢復預設數據</button>
          </div>
          <div id="manualEditGrid" class="grid grid-cols-1 md:grid-cols-2 gap-3 max-h-80 overflow-y-auto"></div>
          <button onclick="saveManualTable()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-1.5 rounded-lg">儲存變更</button>
        </div>
      </div>
    </div>
  </div>

