        <button onclick="openDataModal('json')" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition">
          ⚙️ 更新數據 / JSON 同步
        </button>
      </div>
    </div>
  </header>

  <!-- 左右雙視窗主畫面 -->
  <main class="max-w-7xl mx-auto p-4 grid grid-cols-1 lg:grid-cols-12 gap-4">

    <!-- 左側視窗：目前陣容 -->
